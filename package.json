{
  "name": "caveat",
  "private": true,
  "version": "0.0.0",
  "description": "Long-term memory layer for Claude Code and Codex",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/pnpm.mjs -r build",
    "test": "node scripts/pnpm.mjs -r test",
    "typecheck": "node scripts/pnpm.mjs -r typecheck",
    "check:npm-pack": "node scripts/check-npm-pack.mjs",
    "check:release-smoke": "node --check scripts/check-npm-pack.mjs && node --check scripts/codex-sidecar-advisory-smoke.mjs && node scripts/pnpm.mjs check:npm-pack && node scripts/pnpm.mjs smoke:codex-sidecar-advisory -- --help",
    "smoke:codex-sidecar-advisory": "node scripts/codex-sidecar-advisory-smoke.mjs",
    "eval:hook-search": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/eval-hook-search.mjs",
    "eval:proposal-quality": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/eval-proposal-quality.mjs",
    "prepare:proposal-review": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/prepare-proposal-review.mjs",
    "prepare:proposal-execution": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/prepare-proposal-execution.mjs",
    "prepare:proposal-study": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/prepare-proposal-study.mjs",
    "run:proposal-execution": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/run-proposal-execution.mjs",
    "test:proposal-execution": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/test-proposal-execution.mjs",
    "test:proposal-study": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/test-proposal-study.mjs",
    "prepare:proposal-execution-review": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/prepare-proposal-execution-review.mjs",
    "eval:proposal-execution": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/eval-proposal-execution.mjs",
    "prepare:sidecar-advisory-study": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/prepare-codex-sidecar-advisory-study.mjs",
    "run:sidecar-advisory-eval": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/run-codex-sidecar-advisory-eval.mjs",
    "test:sidecar-advisory-eval": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/test-codex-sidecar-advisory-eval.mjs",
    "eval:sidecar-advisory": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/eval-codex-sidecar-advisory.mjs",
    "prepare:hook-signal-advisory-study": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/prepare-hook-signal-advisory-study.mjs",
    "eval:hook-signal-advisory": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/eval-hook-signal-advisory.mjs",
    "test:hook-signal-advisory": "node scripts/pnpm.mjs --filter @caveat/core build && node scripts/test-hook-signal-advisory-eval.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
